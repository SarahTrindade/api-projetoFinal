<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Consultas - Pet Care</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <%- include('partials/menu') %>

    <h1>Consultas veterinárias</h1>

    <a class="voltar" href="/">
        Voltar para início
    </a>


    <h2>Agendar consulta</h2>

    <form action="/consultas" method="POST">

        <label>Data:</label>
<input 
    type="date" 
    name="data"
    required
>


<label>Hora:</label>
<input 
    type="time" 
    name="hora"
    required
>


<label>Motivo:</label>
<input 
    type="text" 
    name="motivo"
    required
    minlength="3"
>


<label>Status:</label>
<select name="status" required>

    <option value="Agendada">
        Agendada
    </option>

    <option value="Concluída">
        Concluída
    </option>

    <option value="Cancelada">
        Cancelada
    </option>

</select>


<label>ID do Animal:</label>
<input 
    type="number" 
    name="idAnimal"
    required
    min="1"
>


<label>ID do Veterinário:</label>
<input 
    type="number" 
    name="idVeterinario"
    required
    min="1"
>

        <button type="submit">
            Cadastrar consulta
        </button>

    </form>



    <h2>Consultas cadastradas</h2>


    <% if (consultas && consultas.length > 0) { %>


        <% consultas.forEach(consulta => { %>

            <div class="card">

                <p>
                    Data:
                    <%= consulta.data %>
                </p>


                <p>
                    Horário:
                    <%= consulta.hora %>
                </p>


                <p>
                    Motivo:
                    <%= consulta.motivo %>
                </p>


                <p>
                    Status:
                    <%= consulta.status %>
                </p>


            </div>


        <% }) %>


    <% } else { %>

        <p>
            Nenhuma consulta cadastrada.
        </p>

    <% } %>


</body>

</html>