<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Donos - Pet Care</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('partials/menu') %>

    <h1>Donos cadastrados</h1>

    <a href="/">
        Voltar para início
    </a>


    <h2>Cadastrar dono</h2>

    <form action="/donos" method="POST">

        <input 
        type="text" 
        name="nome" 
        required
        >
        
        <input 
        type="email" 
        name="email" 
        required
        >
        
        <input 
        type="tel" 
        name="telefone" 
        required
        >


        <button type="submit">
            Cadastrar
        </button>

    </form>



    <h2>Lista de donos</h2>


    <% if (donos && donos.length > 0) { %>


        <% donos.forEach(dono => { %>


            <div class="card">

                <h3>
                    <%= dono.nome %>
                </h3>


                <p>
                    Email:
                    <%= dono.email %>
                </p>


                <p>
                    Telefone:
                    <%= dono.telefone %>
                </p>


            </div>


        <% }) %>


    <% } else { %>


        <p>
            Nenhum dono cadastrado.
        </p>


    <% } %>


</body>

</html>